# Copy to .env and fill in. Never commit .env.

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5

# Web platform
# Generate with: uv run jobapply hash-password
APP_PASSWORD_HASH=
# Random secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# true in production (HTTPS). false only for local development over http://
COOKIE_SECURE=true

# Production (docker compose): domain served over HTTPS by Caddy, e.g. jobs.example.com
DOMAIN=
